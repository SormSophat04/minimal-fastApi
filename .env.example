# SQLite by default (file app.db created automatically).
# For MySQL: mysql+pymysql://user:password@localhost:3306/dbname
# For Postgres: postgresql+psycopg2://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:///./app.db
# Local MongoDB (no auth by default)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=connect_database
